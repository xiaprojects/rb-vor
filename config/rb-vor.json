{
  "$schema": "./schema/rb-vor.schema.json",
  "version": "1.0",
  "bridge": {
    "ws_url": "ws://localhost/bridge/float/ws",
    "rest_url": "http://localhost/bridge/float",
    "ws_reconnect_min_s": 0.5,
    "ws_reconnect_max_s": 30.0,
    "ws_grace_s": 5.0,
    "http_timeout_s": 0.8
  },
  "publish": {
    "keepalive_s": 5.0,
    "hold_s": 3.0,
    "bearing_ref": "from"
  },
  "sdr": {
    "driver": "pyrtlsdr",
    "device_args": "driver=rtlsdr",
    "device_serial": "",
    "device_index": 0,
    "sample_rate_hz": 1024000,
    "tuner_offset_hz": -256000,
    "gain_mode": "manual",
    "gain_db": 19.2,
    "ppm": 9,
    "bias_tee": false,
    "swap_iq": false,
    "tuner_profiles": {
      "FC0012": {
        "gain_db": 19.2,
        "_note": "VOR antenna in this aircraft. Five gain steps, max 19.2 dB. Zero-IF: if `vor_replay.py --auto-swap` on a capture from THIS dongle says the swapped sense wins, add \"swap_iq\": true HERE -- not globally, the bench R820T does not want it (CLAUDE.md A28, open item O21)."
      },
      "R820T": {
        "gain_db": 32.8,
        "_note": "bench/car dongle; every convention in CLAUDE.md was measured on it"
      }
    },
    "settle_ms": 250,
    "retry_s": 5,
    "buffer_blocks": 16,
    "block_samples": 65536
  },
  "dsp": {
    "channel_lp_hz": 13000,
    "channel_taps": 511,
    "subcarrier_hz": 9960,
    "sub_lp_hz": 700,
    "sub_taps": 255,
    "tone_lp_hz": 100,
    "tone_taps": 127,
    "tone_hz": 30,
    "agc_tau_s": 0.5,
    "integration_s": 2.0,
    "hop_s": 1.0,
    "noise_bins_hz": [
      25.0,
      27.0,
      33.0,
      35.0
    ],
    "_note": "intermediate 32 kHz, demod 4 kHz, output 1 kHz (A9); channel 13 kHz/511 taps and sub 255 taps (A25); 2 s windows at 1 s hop (A25)",
    "afc_threshold_hz": 300.0,
    "afc_tau_s": 1.0,
    "fm_estimator": "discriminator"
  },
  "bearing": {
    "phase_sign": 1,
    "phase_offset_deg": 2.12,
    "station_cal_deg": 0.0,
    "smooth_n": 3
  },
  "quality": {
    "weights": {
      "am": 0.25,
      "sub": 0.1,
      "snr": 0.25,
      "stab": 0.4
    },
    "am_nominal_depth": 0.3,
    "sub_nominal_depth": 0.3,
    "snr_lo_db": 26.0,
    "snr_hi_db": 46.0,
    "stab_full_deg": 10.0,
    "flag_sub_threshold": 0.15,
    "flag_am_threshold": 0.35,
    "flag_stab_threshold": 0.4,
    "history": 5
  },
  "frequency": {
    "min_mhz": 108.0,
    "max_mhz": 117.95,
    "grid_khz": 50,
    "snap_tolerance_khz": 1,
    "debounce_ms": 300,
    "allowlist_mhz": [],
    "denylist_mhz": []
  },
  "record": {
    "enabled": false,
    "dir": "/var/log/rb-vor",
    "format": "cu8",
    "max_seconds": 30,
    "trigger": "on_flag"
  },
  "log": {
    "level": "INFO",
    "solution_csv": "/var/log/rb-vor/vor.csv"
  },
  "loc": {
    "enabled": true,
    "_note": "ILS localizer (CLAUDE.md A33-A37, D9; RB-VOR-IF v2.3). Off until a real localizer has been decoded (docs/loc-plan.md L7). Every other loc key is optional with defaults in rbvor/config.py LOC_DEFAULTS."
  }
}
