# RB-VOR software VOR receiver.
# Installed by install.sh to /etc/systemd/system/rb-vor.service
#
# Runs as a dedicated unprivileged user. SDR access comes from the plugdev
# group plus the udev rule installed alongside this unit -- the daemon never
# needs root, and any instruction telling a builder to run it as root is wrong.

[Unit]
Description=RB-VOR software VOR receiver
Documentation=https://github.com/xiaprojects/rb-vor
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -m rbvor --config /etc/rb-vor/rb-vor.json
WorkingDirectory=/opt/rb-vor
Environment=PYTHONUNBUFFERED=1
User=rb-vor
Group=rb-vor
SupplementaryGroups=plugdev

Restart=always
RestartSec=2
# The controller pings the watchdog from its tick loop (10 Hz). If the DSP or
# the event loop wedges, systemd restarts us rather than leaving a silent
# daemon that a consumer cannot distinguish from a steady one.
WatchdogSec=10
TimeoutStopSec=10

# Hardening. The daemon needs a USB device, a network socket, and two
# directories. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
ReadWritePaths=/var/lib/rb-vor /var/log/rb-vor
StateDirectory=rb-vor
LogsDirectory=rb-vor

[Install]
WantedBy=multi-user.target
